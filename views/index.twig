<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="description" content="A fun, rather complicated card game.">
    <meta name="keywords" content="Card game, game, online game, cards">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <link rel="apple-touch-icon" href="/img/icon-192.png">
    <link rel="icon" sizes="192x192" href="/img/icon-192.png">
    <meta name="apple-mobile-web-app-title" content="Citroni">
    <meta name="mobile-web-app-capable" content="yes">
    <link href="/manifest.json" rel="manifest">

    <link href="https://fonts.googleapis.com/css?family=Pacifico|Wellfleet&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Citroni: The Game</title>
    <style>
    body {
        background-image: url('/img/background-start.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        color: white; 
    }
    
    /* Style for the new image to keep it responsive */
    .hero-image {
        width: 100%;
        max-width: 100px;
        height: auto;
        display: block;
        margin: 20px auto;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.5);
    }

        /* Adds a slight dark overlay so the form and text stay readable */
        body::before {
            content: "";
            position: fixed;
            top: 0; 
            left: 0;
            width: 100%; 
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4); 
            z-index: -1;
        }

        #main-header {
            margin-top: 50px;
            text-shadow: 2px 2px 4px #000;
        }
    </style>
</head>
</head>
<body>
    <h3 id="main-header" class="text-center">Citroni<small class="text-muted"> The Game</small></h3>
    <div class="container">
        
        <img src="/img/area-205-logo.jpeg" alt="Citroni Game Logo" class="hero-image">

        <div class="space"></div>
        
        {% for problem in problems %}
        <div class="alert alert-danger space">
            <strong>Error:</strong> {{problem}}
        </div>
        {% endfor %}
        
        {% if playerName != null %}
            <h4 class="text-success">Welcome back, {{playerName}}!</h4>
            <p>You are ready to play.</p>
            <a href="/game" type="button" class="btn btn-primary btn-lg btn-block">Quick play</a>

            <div class="mt-4 p-3 rounded" style="background-color: rgba(0, 0, 0, 0.5);">
                <h5>Lobbies</h5>
                <div id="lobby-list">
                    <p class="text-muted mb-0">Loading lobbies...</p>
                </div>
                <form action="/game" method="GET" class="form-row mt-3">
                    <div class="col">
                        <input type="text" class="form-control" name="lobby" placeholder="new lobby name" required maxlength="16" pattern="[A-Za-z0-9_\-]{1,16}" title="1-16 characters: a-z, 0-9, _ or -">
                    </div>
                    <div class="col-auto">
                        <input type="submit" class="btn btn-success" value="Create lobby">
                    </div>
                </form>
            </div>

            <a href="/logout" type="button" class="btn btn-danger btn-sm btn-block mt-3">Logout</a>

            <script>
                function renderLobbies(lobbies) {
                    var list = document.getElementById("lobby-list");
                    list.innerHTML = "";
                    if (lobbies.length === 0) {
                        var empty = document.createElement("p");
                        empty.className = "text-muted mb-0";
                        empty.textContent = "No lobbies right now — create one below or use quick play!";
                        list.appendChild(empty);
                        return;
                    }
                    lobbies.forEach(function (lobby) {
                        var row = document.createElement("div");
                        row.className = "d-flex justify-content-between align-items-center border-bottom border-secondary py-2";

                        var info = document.createElement("div");
                        var title = document.createElement("strong");
                        title.textContent = lobby.name;
                        var status = document.createElement("span");
                        status.className = "badge ml-2 " + (lobby.inGame ? "badge-warning" : "badge-success");
                        status.textContent = lobby.inGame ? "in game" : "waiting";
                        var playersLine = document.createElement("div");
                        playersLine.className = "small";
                        playersLine.textContent = lobby.playerCount + "/" + lobby.maxPlayers + " players: " + lobby.players.join(", ");
                        info.appendChild(title);
                        info.appendChild(status);
                        info.appendChild(playersLine);

                        var joinButton = document.createElement("a");
                        joinButton.className = "btn btn-primary btn-sm";
                        if (!lobby.inGame && lobby.playerCount < lobby.maxPlayers) {
                            joinButton.href = "/game?lobby=" + encodeURIComponent(lobby.name);
                            joinButton.textContent = "Join";
                        } else {
                            joinButton.className += " disabled";
                            joinButton.textContent = lobby.inGame ? "Started" : "Full";
                        }

                        row.appendChild(info);
                        row.appendChild(joinButton);
                        list.appendChild(row);
                    });
                }

                var lastLobbiesJson = null;
                function refreshLobbies() {
                    fetch("/lobbies")
                        .then(function (res) { return res.json(); })
                        .then(function (lobbies) {
                            var json = JSON.stringify(lobbies);
                            if (json === lastLobbiesJson)
                                return; // nothing changed, don't rebuild the list under the user's cursor
                            lastLobbiesJson = json;
                            renderLobbies(lobbies);
                        })
                        .catch(function () {});
                }
                refreshLobbies();
                setInterval(refreshLobbies, 3000);
            </script>
        {% else %}
            <p>Before you can play, you must enter a name to identify yourself.</p>
            <form action="/setName" method="POST">
                <input type="text" minlength="2" class="form-control-plaintext" name="name" placeholder="enter your name here">
                <input type="submit" class="btn btn-primary btn-lg btn-block" value="Set name">
            </form>
        {% endif %}

        <div class="mt-4">
            <h5>Special cards:</h5>
            <ul class="list-unstyled">
                <li><strong>3</strong> - starts from beginning</li>
                <li><strong>6</strong> - transparent, keeps the value from last card</li>
                <li><strong>10</strong> - burns the stack</li>
                <li><strong>Joker</strong> - burns the stack</li>
                <li><strong>4 of the same</strong> burns the stack.</li>
            </ul>
        </div>
    </div>
    </body>
</html>